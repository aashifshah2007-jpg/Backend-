# Render environment variables: one set per client.
# Replace every value that says YOUR_ / client@ for each new client.

# Client's Supabase project (Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SECRET: service_role key. Render only. Never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Client's Resend account
RESEND_API_KEY=re_your_key
# Where new-order alerts go. With the Resend test sender this must be the
# email address the client used to sign up to Resend.
CLIENT_EMAIL=client@example.com
# Optional. Default is the Resend test sender.
RESEND_FROM=BASEIC Store <onboarding@resend.dev>

# Your Netlify URL for this client (comma-separate to allow several)
FRONTEND_URL=https://your-storefront.netlify.app
